{
  "name": "valence",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted multi-node PaaS and container orchestrator",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @paas/database db:generate",
    "db:push": "pnpm --filter @paas/database db:push",
    "db:migrate": "pnpm --filter @paas/database db:migrate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
