# Database (PostgreSQL 16)
DATABASE_URL="postgresql://paas_admin:paas_dev_password@localhost:5432/paas_core?schema=public"

# Control Plane (api-core)
PORT=3000
JWT_ACCESS_SECRET="replace-with-32-byte-access-secret"
JWT_REFRESH_SECRET="replace-with-32-byte-refresh-secret"
VAULT_MASTER_KEY="replace-with-32-byte-master-vault-key"

# Redis (BullMQ & Pub/Sub)
REDIS_HOST="localhost"
REDIS_PORT=6379

# S3 / MinIO Backup Storage
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio_admin"
S3_SECRET_KEY="minio_dev_password"
S3_BUCKET="paas-backups"

# Host Agent
DOCKER_SOCKET_PATH="/var/run/docker.sock"
PORT_RANGE_MIN=10000
PORT_RANGE_MAX=20000
